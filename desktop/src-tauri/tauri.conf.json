{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llm-agent-spend-manager",
  "version": "0.0.1",
  "identifier": "com.rentheria.llm-agent-spend-manager",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "llm-agent-spend-manager",
        "width": 900,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "url": "http://127.0.0.1:4600"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
